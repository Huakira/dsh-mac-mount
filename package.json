{
	"name": "dsh-mac-mount",
	"version": "0.1.0",
	"description": "Cowork-style per-session mounting of a local (Mac) folder for DSH sessions",
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./locale/*": "./locale/*.json",
		"./icon": "./icon.svg",
		"./cordis.patch.yml": "./cordis.patch.yml"
	},
	"files": [
		"index.js",
		"cordis.patch.yml",
		"locale/*.json",
		"icon.svg"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	}
}
